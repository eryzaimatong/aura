{
  "name": "aura-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:dev": "node scripts/copy-mediapipe.mjs && vite build --mode android && cap sync android",
    "android:open": "cap open android",
    "android:icons": "capacitor-assets generate --android --assetPath resources --iconBackgroundColor \"#FDF6EC\" --splashBackgroundColor \"#FDF6EC\"",
    "android:apk": "node scripts/android-gradle.mjs assembleDebug --console=plain",
    "android:bundle": "npm run android:sync && node scripts/android-gradle.mjs bundleRelease --console=plain",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  }
}
