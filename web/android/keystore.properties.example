# Copy to keystore.properties (gitignored) and fill in. Paths are relative to web/android/.
# Create the upload key once with:
#   keytool -genkeypair -v -keystore aura-upload.jks -alias aura -keyalg RSA -keysize 2048 -validity 10000
storeFile=aura-upload.jks
storePassword=
keyAlias=aura
keyPassword=
