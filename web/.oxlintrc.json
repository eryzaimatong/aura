{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/purity": "off",
    "react/set-state-in-effect": "off",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "dist",
    "android",
    "public"
  ]
}
