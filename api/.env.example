# Copy to .env. Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://localhost,http://localhost,capacitor://localhost
# Same values as web/.env.local (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
# The API acts as the signed-in user, so RLS still applies — no service-role key here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Interactive docs at /docs (keep off in production)
EXPOSE_DOCS=true
